# WebSentry environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- MongoDB Atlas (free M0 tier) -------------------------------------------
# Leave blank to fall back to an in-memory store (development only).
MONGODB_URI=
MONGODB_DATABASE=websentry

# --- Anthropic Claude API ----------------------------------------------------
# Separate product from a Claude Pro chat subscription. Needs its own credits
# from console.anthropic.com. Leave blank to use the templated explanation
# fallback: the system stays fully functional without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=200

# --- Google Safe Browsing (optional) -----------------------------------------
# Optional at runtime by design. If blank, the check is skipped and the scan
# proceeds on rule checks plus the ML model alone.
SAFE_BROWSING_API_KEY=

# --- Internal ML service ------------------------------------------------------
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=1500

# --- Scoring engine selection -------------------------------------------------
# ml  = Version B, local model scores and Claude explains (committed architecture)
# llm = Version A, Claude produces the score as well
WEBSENTRY_SCORER=ml

# --- Admin dashboard (hardcoded single admin, per the compressed scope) -------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-demo
